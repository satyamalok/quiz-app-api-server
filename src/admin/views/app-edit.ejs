<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit App - Quiz Admin</title>
    <%- include('partials/head') %>
    <style>
        .form-card {
            max-width: 600px;
        }
        .readonly-field {
            background: #f5f5f5;
            border: 1px solid #ddd;
            padding: 10px;
            border-radius: 5px;
            font-family: monospace;
        }
        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin: 20px 0;
        }
        .stat-box {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }
        .stat-box .value {
            font-size: 24px;
            font-weight: 600;
            color: #667eea;
        }
        .stat-box .label {
            font-size: 12px;
            color: #666;
            margin-top: 5px;
        }
        .danger-zone {
            border: 2px solid #dc3545;
            border-radius: 8px;
            padding: 20px;
            margin-top: 30px;
        }
        .danger-zone h3 {
            color: #dc3545;
            margin-bottom: 15px;
        }
        .btn-danger {
            background: #dc3545;
        }
        .btn-danger:hover {
            background: #c82333;
        }
        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .checkbox-group input {
            width: 20px;
            height: 20px;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <h1>Edit App: <%= app.name %></h1>

        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>

        <div class="stats-row">
            <div class="stat-box">
                <div class="value"><%= stats.users %></div>
                <div class="label">Users</div>
            </div>
            <div class="stat-box">
                <div class="value"><%= stats.questions %></div>
                <div class="label">Questions</div>
            </div>
            <div class="stat-box">
                <div class="value"><%= stats.videos %></div>
                <div class="label">Videos</div>
            </div>
            <div class="stat-box">
                <div class="value"><%= stats.reels %></div>
                <div class="label">Reels</div>
            </div>
        </div>

        <div class="card form-card">
            <h2>App Details</h2>
            <form action="/admin/apps/<%= app.id %>/update" method="POST">
                <div class="form-group">
                    <label>Slug (cannot be changed)</label>
                    <div class="readonly-field"><%= app.slug %></div>
                </div>

                <div class="form-group">
                    <label>API Base URL</label>
                    <div class="readonly-field">/api/v1/<%= app.slug %>/...</div>
                </div>

                <div class="form-group">
                    <label>MinIO Bucket</label>
                    <div class="readonly-field"><%= app.minio_bucket || app.slug %></div>
                </div>

                <div class="form-group">
                    <label for="name">App Name</label>
                    <input type="text" id="name" name="name" value="<%= app.name %>" required>
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description" rows="3"><%= app.description || '' %></textarea>
                </div>

                <div class="form-group">
                    <div class="checkbox-group">
                        <input type="checkbox" id="is_active" name="is_active" <%= app.is_active ? 'checked' : '' %>>
                        <label for="is_active" style="margin: 0;">App is Active</label>
                    </div>
                    <div class="helper-text" style="margin-left: 30px; margin-top: 5px;">
                        Inactive apps will return 403 error for all API requests
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit">Save Changes</button>
                    <a href="/admin/apps" class="btn" style="background: #6c757d; margin-left: 10px;">Cancel</a>
                </div>
            </form>
        </div>

        <div class="card form-card">
            <h2>App Info</h2>
            <table>
                <tr>
                    <td><strong>Created At</strong></td>
                    <td><%= new Date(app.created_at).toLocaleString() %></td>
                </tr>
                <tr>
                    <td><strong>Updated At</strong></td>
                    <td><%= new Date(app.updated_at).toLocaleString() %></td>
                </tr>
                <tr>
                    <td><strong>Total XP Earned</strong></td>
                    <td><%= stats.totalXp.toLocaleString() %></td>
                </tr>
            </table>
        </div>

        <div class="danger-zone">
            <h3>Danger Zone</h3>
            <p style="margin-bottom: 15px;">
                Deleting an app will permanently remove all data including users, questions,
                videos, and progress. This action cannot be undone.
            </p>
            <form action="/admin/apps/<%= app.id %>/delete" method="POST"
                  onsubmit="return confirm('Are you ABSOLUTELY sure? This will delete ALL data for this app!')">
                <div class="form-group" style="margin-bottom: 10px;">
                    <label>Type <strong>DELETE</strong> to confirm:</label>
                    <input type="text" name="confirm" placeholder="DELETE" style="max-width: 200px;">
                </div>
                <button type="submit" class="btn btn-danger">Delete App Permanently</button>
            </form>
        </div>
    </div>
</body>
</html>
