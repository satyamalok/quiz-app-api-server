<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isEdit ? 'Edit' : 'Create' %> Item - Admin</title>
    <%- include('partials/head') %>
    <style>
        .form-container {
            max-width: 700px;
            margin: 0 auto;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        .form-group input[type="text"],
        .form-group input[type="number"],
        .form-group input[type="datetime-local"],
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 14px;
        }
        .form-group textarea {
            min-height: 100px;
        }
        .form-group small {
            color: #666;
            display: block;
            margin-top: 5px;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .section-title {
            font-size: 16px;
            font-weight: bold;
            margin: 30px 0 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }
        .current-file {
            padding: 10px;
            background: #f8f9fa;
            border-radius: 5px;
            margin-bottom: 10px;
        }
        .current-thumbnail {
            width: 100px;
            height: 130px;
            object-fit: cover;
            border-radius: 5px;
            margin-bottom: 10px;
        }
        .form-actions {
            display: flex;
            gap: 10px;
            margin-top: 30px;
        }
        .alert {
            padding: 10px 15px;
            border-radius: 5px;
            margin-bottom: 15px;
        }
        .alert-error {
            background: #f8d7da;
            color: #721c24;
        }
        .conditional-section {
            margin-left: 25px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 5px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <div class="form-container">
            <h2><%= isEdit ? 'Edit' : 'Create' %> Item</h2>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error"><%= error %></div>
            <% } %>

            <form action="/admin/shop/items/<%= isEdit ? item.id + '/update' : 'create' %>"
                  method="POST" enctype="multipart/form-data">

                <!-- Basic Info -->
                <div class="form-group">
                    <label for="chapter_id">Chapter</label>
                    <select id="chapter_id" name="chapter_id">
                        <option value="" <%= !item || !item.chapter_id ? 'selected' : '' %>>-- No Chapter (Independent Item) --</option>
                        <% chapters.forEach(c => { %>
                        <option value="<%= c.id %>" <%= item && item.chapter_id === c.id ? 'selected' : '' %>>
                            <%= c.name %>
                        </option>
                        <% }); %>
                    </select>
                    <small>Leave empty for independent items that aren't part of any chapter</small>
                </div>

                <div class="form-group">
                    <label for="item_type">Item Type *</label>
                    <select id="item_type" name="item_type" required>
                        <option value="pdf" <%= !item || item.item_type === 'pdf' ? 'selected' : '' %>>PDF</option>
                        <option value="video" <%= item && item.item_type === 'video' ? 'selected' : '' %>>Video</option>
                        <option value="notes" <%= item && item.item_type === 'notes' ? 'selected' : '' %>>Notes</option>
                        <option value="other" <%= item && item.item_type === 'other' ? 'selected' : '' %>>Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="title">Title *</label>
                    <input type="text" id="title" name="title" required
                           value="<%= item ? item.title : '' %>"
                           placeholder="e.g., Algebra Complete Notes">
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description"
                              placeholder="Describe what's included in this PDF"><%= item ? item.description : '' %></textarea>
                </div>

                <!-- Files -->
                <div class="section-title">Files</div>

                <div class="form-group">
                    <label for="pdf_file">Content File <%= isEdit ? '' : '*' %></label>
                    <% if (isEdit && item && item.pdf_url) { %>
                    <div class="current-file">
                        <strong>Current File:</strong>
                        <a href="<%= item.pdf_url %>" target="_blank">View/Download</a>
                        <% if (item.file_size_bytes) { %>
                        (<%= (item.file_size_bytes / 1024 / 1024).toFixed(2) %> MB)
                        <% } %>
                    </div>
                    <small>Upload new file to replace:</small>
                    <% } %>
                    <input type="file" id="pdf_file" name="pdf_file" accept=".pdf,.mp4,.webm,.mov" <%= isEdit ? '' : 'required' %>>
                    <small>PDF or Video files. Max size: 100MB</small>
                </div>

                <div class="form-group">
                    <label for="thumbnail">Thumbnail Image</label>
                    <% if (isEdit && item && item.thumbnail_url) { %>
                    <div>
                        <img src="<%= item.thumbnail_url %>" class="current-thumbnail" alt="">
                        <div class="checkbox-group">
                            <input type="checkbox" id="remove_thumbnail" name="remove_thumbnail">
                            <label for="remove_thumbnail" style="font-weight:normal">Remove thumbnail</label>
                        </div>
                    </div>
                    <% } %>
                    <input type="file" id="thumbnail" name="thumbnail" accept="image/*">
                    <small>Recommended: 200x260px (portrait). Optional.</small>
                </div>

                <div class="form-group">
                    <label for="page_count">Page Count</label>
                    <input type="number" id="page_count" name="page_count" min="0"
                           value="<%= item ? item.page_count : '' %>"
                           placeholder="Optional">
                </div>

                <!-- Pricing -->
                <div class="section-title">Pricing</div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="xp_price">XP Price *</label>
                        <input type="number" id="xp_price" name="xp_price" min="0" required
                               value="<%= item ? item.xp_price : 0 %>">
                        <small>Set to 0 for free items</small>
                    </div>
                    <div class="form-group">
                        <label for="display_order">Display Order</label>
                        <input type="number" id="display_order" name="display_order" min="0"
                               value="<%= item ? item.display_order : 0 %>">
                    </div>
                </div>

                <!-- Sale -->
                <div class="form-group">
                    <div class="checkbox-group">
                        <input type="checkbox" id="enable_sale"
                               <%= item && item.xp_original_price ? 'checked' : '' %>
                               onchange="toggleSaleSection()">
                        <label for="enable_sale" style="font-weight:normal">Enable Sale Price</label>
                    </div>

                    <div id="saleSection" class="conditional-section" style="display:<%= item && item.xp_original_price ? 'block' : 'none' %>">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="xp_original_price">Original Price (XP)</label>
                                <input type="number" id="xp_original_price" name="xp_original_price" min="0"
                                       value="<%= item ? item.xp_original_price : '' %>">
                                <small>Price shown with strikethrough</small>
                            </div>
                            <div class="form-group">
                                <label for="sale_ends_at">Sale Ends At</label>
                                <input type="datetime-local" id="sale_ends_at" name="sale_ends_at"
                                       value="<%= item && item.sale_ends_at ? new Date(item.sale_ends_at).toISOString().slice(0,16) : '' %>">
                                <small>Optional. Leave empty for no expiry.</small>
                            </div>
                        </div>
                        <% if (isEdit && item && item.xp_original_price) { %>
                        <div class="checkbox-group">
                            <input type="checkbox" id="clear_sale" name="clear_sale">
                            <label for="clear_sale" style="font-weight:normal">Clear sale (reset to regular price)</label>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Stock -->
                <div class="section-title">Stock Management</div>

                <div class="form-group">
                    <div class="checkbox-group">
                        <input type="checkbox" id="is_stock_enabled" name="is_stock_enabled"
                               <%= item && item.is_stock_enabled ? 'checked' : '' %>
                               onchange="toggleStockSection()">
                        <label for="is_stock_enabled" style="font-weight:normal">Enable Stock Limit</label>
                    </div>

                    <div id="stockSection" class="conditional-section" style="display:<%= item && item.is_stock_enabled ? 'block' : 'none' %>">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="stock_total">Total Stock</label>
                                <input type="number" id="stock_total" name="stock_total" min="0"
                                       value="<%= item ? item.stock_total : '' %>">
                            </div>
                            <% if (isEdit) { %>
                            <div class="form-group">
                                <label for="stock_remaining">Remaining Stock</label>
                                <input type="number" id="stock_remaining" name="stock_remaining" min="0"
                                       value="<%= item ? item.stock_remaining : '' %>">
                                <small>Adjust to restock</small>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Status -->
                <div class="section-title">Status</div>

                <div class="form-group">
                    <div class="checkbox-group">
                        <input type="checkbox" id="is_active" name="is_active"
                               <%= (item && item.is_active) || !isEdit ? 'checked' : '' %>>
                        <label for="is_active" style="font-weight:normal">Active (visible in app)</label>
                    </div>
                </div>

                <div class="form-group">
                    <div class="checkbox-group">
                        <input type="checkbox" id="is_featured" name="is_featured"
                               <%= item && item.is_featured ? 'checked' : '' %>>
                        <label for="is_featured" style="font-weight:normal">Featured (show on homepage)</label>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <%= isEdit ? 'Update Item' : 'Create Item' %>
                    </button>
                    <a href="/admin/shop/items" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        function toggleSaleSection() {
            const enabled = document.getElementById('enable_sale').checked;
            document.getElementById('saleSection').style.display = enabled ? 'block' : 'none';
            if (!enabled) {
                document.getElementById('xp_original_price').value = '';
                document.getElementById('sale_ends_at').value = '';
            }
        }
        function toggleStockSection() {
            const enabled = document.getElementById('is_stock_enabled').checked;
            document.getElementById('stockSection').style.display = enabled ? 'block' : 'none';
        }
    </script>
</body>
</html>
