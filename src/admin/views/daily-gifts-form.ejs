<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isEdit ? 'Edit' : 'Create' %> Daily Gift - Admin</title>
    <%- include('partials/head') %>
    <style>
        .form-container {
            max-width: 800px;
            margin: 0 auto;
        }
        .form-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .form-section h3 {
            margin: 0 0 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
            font-size: 16px;
            color: #333;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 500;
            color: #333;
        }
        .form-group input[type="text"],
        .form-group input[type="number"],
        .form-group input[type="date"],
        .form-group input[type="time"],
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 14px;
        }
        .form-group textarea {
            min-height: 100px;
            resize: vertical;
        }
        .form-group small {
            display: block;
            margin-top: 5px;
            color: #666;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        .form-row-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 15px;
        }
        .checkbox-group {
            display: flex;
            gap: 20px;
            align-items: center;
        }
        .checkbox-group label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: normal;
        }
        .file-preview {
            margin-top: 10px;
            padding: 10px;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        .file-preview img {
            max-width: 150px;
            max-height: 150px;
            border-radius: 4px;
        }
        .current-file {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .current-file a {
            color: #007bff;
        }
        .button-row {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }
        .scheduling-info {
            background: #cce5ff;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 15px;
        }
        .scheduling-info h4 {
            margin: 0 0 10px;
            color: #004085;
            font-size: 14px;
        }
        .scheduling-info p {
            margin: 0;
            color: #004085;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <div class="form-container">
            <h1><%= isEdit ? 'Edit' : 'Create' %> Daily Gift</h1>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <form method="POST"
                  action="<%= isEdit ? `/admin/daily-gifts/${gift.id}/update` : '/admin/daily-gifts/create' %>"
                  enctype="multipart/form-data">

                <!-- Scheduling -->
                <div class="form-section">
                    <h3>Scheduling</h3>

                    <div class="scheduling-info">
                        <h4>How Daily Gifts Work</h4>
                        <p>
                            Students can see and purchase this gift only on or after the scheduled date and time (IST).
                            Upcoming gifts are visible as previews but cannot be purchased until available.
                        </p>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="available_date">Available Date *</label>
                            <input type="date" id="available_date" name="available_date" required
                                   value="<%= gift?.available_date ? new Date(gift.available_date).toISOString().split('T')[0] : '' %>">
                            <small>Date when gift becomes available (IST)</small>
                        </div>

                        <div class="form-group">
                            <label for="available_time">Available Time</label>
                            <input type="time" id="available_time" name="available_time"
                                   value="<%= gift?.available_time || '00:00' %>">
                            <small>Time when gift unlocks (defaults to midnight IST)</small>
                        </div>
                    </div>
                </div>

                <!-- Basic Info -->
                <div class="form-section">
                    <h3>Gift Information</h3>

                    <div class="form-group">
                        <label for="title">Title *</label>
                        <input type="text" id="title" name="title" required
                               value="<%= gift?.title || '' %>"
                               placeholder="e.g., December 11 Special Notes">
                    </div>

                    <div class="form-group">
                        <label for="description">Description</label>
                        <textarea id="description" name="description"
                                  placeholder="Describe what's included in this gift..."><%= gift?.description || '' %></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="content_type">Content Type *</label>
                            <select id="content_type" name="content_type" required onchange="toggleContentTypeFields()">
                                <option value="pdf" <%= gift?.content_type === 'pdf' ? 'selected' : '' %>>PDF Document</option>
                                <option value="video" <%= gift?.content_type === 'video' ? 'selected' : '' %>>Video</option>
                                <option value="notes" <%= gift?.content_type === 'notes' ? 'selected' : '' %>>Notes</option>
                                <option value="image" <%= gift?.content_type === 'image' ? 'selected' : '' %>>Image (Mindmap)</option>
                                <option value="surprise" <%= gift?.content_type === 'surprise' ? 'selected' : '' %>>Surprise</option>
                                <option value="digital" <%= gift?.content_type === 'digital' ? 'selected' : '' %>>Digital (WhatsApp)</option>
                                <option value="link" <%= gift?.content_type === 'link' ? 'selected' : '' %>>Link (External URL)</option>
                                <option value="other" <%= gift?.content_type === 'other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="xp_price">XP Price *</label>
                            <input type="number" id="xp_price" name="xp_price" min="0" required
                                   value="<%= gift?.xp_price ?? 0 %>">
                            <small>Set to 0 for free gift</small>
                        </div>
                    </div>
                </div>

                <!-- File Upload -->
                <div class="form-section">
                    <h3>Gift File</h3>

                    <div class="form-group" id="file_upload_section">
                        <label for="gift_file">
                            <%= isEdit ? 'Replace File (optional)' : 'Upload File *' %>
                        </label>
                        <input type="file" id="gift_file" name="gift_file"
                               accept=".pdf,video/*,image/*">
                        <small>Supported: PDF files, MP4/WebM videos, Images (max 100MB)</small>

                        <% if (isEdit && gift?.file_url) { %>
                        <div class="file-preview">
                            <div class="current-file">
                                <span>Current file:</span>
                                <a href="<%= gift.file_url %>" target="_blank">View File</a>
                                <% if (gift.file_size_bytes) { %>
                                    <span style="color: #666;">
                                        (<%= Math.round(gift.file_size_bytes / 1024 / 1024 * 10) / 10 %> MB)
                                    </span>
                                <% } %>
                            </div>
                        </div>
                        <% } %>
                    </div>

                    <div class="form-group">
                        <label for="thumbnail">Thumbnail Image</label>
                        <input type="file" id="thumbnail" name="thumbnail" accept="image/*">
                        <small>Preview image for the gift</small>

                        <% if (isEdit && gift?.thumbnail_url) { %>
                        <div class="file-preview">
                            <img src="<%= gift.thumbnail_url %>" alt="Current thumbnail">
                            <div style="margin-top: 10px;">
                                <label>
                                    <input type="checkbox" name="remove_thumbnail"> Remove current thumbnail
                                </label>
                            </div>
                        </div>
                        <% } %>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="page_count">Page Count</label>
                            <input type="number" id="page_count" name="page_count" min="0"
                                   value="<%= gift?.page_count || '' %>"
                                   placeholder="For PDFs">
                        </div>

                        <div class="form-group">
                            <label for="duration_seconds">Duration (seconds)</label>
                            <input type="number" id="duration_seconds" name="duration_seconds" min="0"
                                   value="<%= gift?.duration_seconds || '' %>"
                                   placeholder="For videos">
                        </div>
                    </div>
                </div>

                <!-- YouTube/Video Section -->
                <div class="form-section" id="youtube_section" style="display: none;">
                    <h3>YouTube Video Settings</h3>
                    <p style="color: #666; margin-bottom: 15px;">
                        Use a YouTube URL instead of uploading a video file. Leave empty to use uploaded file.
                    </p>

                    <div class="form-group">
                        <label for="youtube_url">YouTube URL</label>
                        <input type="url" id="youtube_url" name="youtube_url"
                               value="<%= gift?.youtube_url || '' %>"
                               placeholder="https://www.youtube.com/watch?v=...">
                        <small>Paste full YouTube URL (regular or shorts)</small>
                    </div>

                    <div class="form-group">
                        <label for="video_orientation">Video Orientation</label>
                        <select id="video_orientation" name="video_orientation">
                            <option value="horizontal" <%= (!gift?.video_orientation || gift?.video_orientation === 'horizontal') ? 'selected' : '' %>>Horizontal (16:9)</option>
                            <option value="vertical" <%= gift?.video_orientation === 'vertical' ? 'selected' : '' %>>Vertical (9:16)</option>
                        </select>
                        <small>Select based on video aspect ratio</small>
                    </div>
                </div>

                <!-- Link Section -->
                <div class="form-section" id="link_section" style="display: none;">
                    <h3>External Link Settings</h3>
                    <p style="color: #666; margin-bottom: 15px;">
                        Link items redirect users to an external URL. No file upload needed.
                    </p>

                    <div class="form-group">
                        <label for="redirect_url">Redirect URL *</label>
                        <input type="url" id="redirect_url" name="redirect_url"
                               value="<%= gift?.redirect_url || '' %>"
                               placeholder="https://example.com/resource">
                        <small>External URL to redirect the user to</small>
                    </div>
                </div>

                <!-- Digital Item Section (WhatsApp Redirect) -->
                <div class="form-section" id="digital_section" style="display: none;">
                    <h3>WhatsApp Redirect Settings</h3>
                    <p style="color: #666; margin-bottom: 15px;">
                        Digital gifts redirect users to WhatsApp with a predefined message. No file upload needed.
                    </p>

                    <div class="form-group">
                        <label for="whatsapp_agent_id">Select Agent *</label>
                        <select id="whatsapp_agent_id" name="whatsapp_agent_id">
                            <option value="">-- Select Agent --</option>
                            <option value="auto" <%= gift?.whatsapp_agent_id === null && gift?.content_type === 'digital' ? '' : '' %>>
                                🔄 Auto-select (Distribution System)
                            </option>
                            <% if (typeof agents !== 'undefined' && agents) { %>
                                <% agents.forEach(agent => { %>
                                <option value="<%= agent.id %>"
                                    <%= gift?.whatsapp_agent_id === agent.id ? 'selected' : '' %>>
                                    <%= agent.name %> (<%= agent.whatsapp_number %>)
                                </option>
                                <% }); %>
                            <% } %>
                        </select>
                        <small>Select a specific agent, or use "Auto-select" to let the system choose based on distribution rules</small>
                    </div>

                    <div class="form-group">
                        <label for="whatsapp_message">WhatsApp Message *</label>
                        <textarea id="whatsapp_message" name="whatsapp_message"
                                  placeholder="Hi! I am interested in this gift. My phone: {user_phone}"><%= gift?.whatsapp_message || '' %></textarea>
                        <small>Placeholders: {user_name}, {user_phone}, {item_title}</small>
                    </div>
                </div>

                <!-- Status -->
                <div class="form-section">
                    <h3>Status</h3>

                    <div class="checkbox-group">
                        <label>
                            <input type="checkbox" name="is_active"
                                   <%= !isEdit || gift?.is_active ? 'checked' : '' %>>
                            Active (visible to users)
                        </label>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="button-row">
                    <button type="submit" class="btn btn-primary">
                        <%= isEdit ? 'Update Gift' : 'Create Gift' %>
                    </button>
                    <a href="/admin/daily-gifts" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        function toggleContentTypeFields() {
            const contentType = document.getElementById('content_type').value;
            const digitalSection = document.getElementById('digital_section');
            const youtubeSection = document.getElementById('youtube_section');
            const linkSection = document.getElementById('link_section');
            const fileSection = document.getElementById('file_upload_section');
            const fileInput = document.getElementById('gift_file');

            // Hide all optional sections first
            digitalSection.style.display = 'none';
            youtubeSection.style.display = 'none';
            linkSection.style.display = 'none';
            fileSection.style.display = 'block';
            fileInput.removeAttribute('required');

            if (contentType === 'digital') {
                // Digital: Show WhatsApp settings, hide file upload
                digitalSection.style.display = 'block';
                fileSection.style.display = 'none';
            } else if (contentType === 'video') {
                // Video: Show YouTube options and file upload
                youtubeSection.style.display = 'block';
                fileSection.style.display = 'block';
            } else if (contentType === 'link') {
                // Link: Show redirect URL, hide file upload
                linkSection.style.display = 'block';
                fileSection.style.display = 'none';
            } else {
                // Other types: Show file upload
                fileSection.style.display = 'block';
                <% if (!isEdit) { %>
                fileInput.setAttribute('required', 'required');
                <% } %>
            }
        }

        // Run on page load
        document.addEventListener('DOMContentLoaded', toggleContentTypeFields);
    </script>
</body>
</html>
