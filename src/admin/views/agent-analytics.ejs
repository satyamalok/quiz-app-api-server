<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agent Analytics - Admin</title>
    <%- include('partials/head') %>
    <style>
        .page-nav {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }
        .page-nav a {
            padding: 8px 15px;
            background: #f0f0f0;
            border-radius: 5px;
            text-decoration: none;
            color: #333;
        }
        .page-nav a.active {
            background: #007bff;
            color: white;
        }
        .filters-row {
            display: flex;
            gap: 15px;
            align-items: center;
            margin-bottom: 25px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
        }
        .filters-row label {
            font-weight: 500;
        }
        .filters-row select {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            min-width: 150px;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: white;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
        }
        .stat-card h4 {
            margin: 0 0 10px;
            font-size: 32px;
            color: #007bff;
        }
        .stat-card p {
            margin: 0;
            color: #666;
            font-size: 14px;
        }
        .stat-card.highlight {
            background: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
            color: white;
        }
        .stat-card.highlight h4 {
            color: white;
        }
        .stat-card.highlight p {
            color: rgba(255,255,255,0.8);
        }
        .section {
            margin-bottom: 30px;
        }
        .section h2 {
            margin: 0 0 15px;
            font-size: 20px;
            color: #333;
        }
        .chart-container {
            background: white;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 20px;
        }
        .agent-bar {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
        }
        .agent-bar-label {
            width: 150px;
            font-weight: 500;
            font-size: 14px;
        }
        .agent-bar-track {
            flex: 1;
            height: 30px;
            background: #f0f0f0;
            border-radius: 5px;
            overflow: hidden;
        }
        .agent-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #6c5ce7, #a29bfe);
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 10px;
            color: white;
            font-weight: bold;
            font-size: 14px;
            min-width: 40px;
        }
        .agent-code {
            background: #6c5ce7;
            color: white;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 10px;
            margin-left: 5px;
        }
        .data-table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 8px;
            overflow: hidden;
        }
        .data-table th,
        .data-table td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }
        .data-table th {
            background: #f8f9fa;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            color: #666;
        }
        .data-table tr:hover {
            background: #f8f9fa;
        }
        .two-columns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }
        .trigger-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 500;
        }
        .trigger-badge.purchase { background: #d4edda; color: #155724; }
        .trigger-badge.button_click { background: #cce5ff; color: #004085; }
        .trigger-badge.auto { background: #f8d7da; color: #721c24; }
        .message-preview {
            max-width: 300px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 12px;
            color: #666;
        }
        .empty-state {
            text-align: center;
            padding: 40px;
            color: #666;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <div class="page-nav">
            <a href="/admin/agents">Agents</a>
            <a href="/admin/agent-messages">Messages</a>
            <a href="/admin/agent-distribution">Distribution</a>
            <a href="/admin/agent-analytics" class="active">Analytics</a>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <h1>Agent Redirect Analytics</h1>

        <!-- Filters -->
        <form method="GET" class="filters-row">
            <label>Time Period:</label>
            <select name="days" onchange="this.form.submit()">
                <option value="7" <%= filters.days == 7 ? 'selected' : '' %>>Last 7 days</option>
                <option value="14" <%= filters.days == 14 ? 'selected' : '' %>>Last 14 days</option>
                <option value="30" <%= filters.days == 30 ? 'selected' : '' %>>Last 30 days</option>
                <option value="60" <%= filters.days == 60 ? 'selected' : '' %>>Last 60 days</option>
                <option value="90" <%= filters.days == 90 ? 'selected' : '' %>>Last 90 days</option>
            </select>

            <label>Agent:</label>
            <select name="agent_id" onchange="this.form.submit()">
                <option value="">All Agents</option>
                <% agents.forEach(agent => { %>
                    <option value="<%= agent.id %>" <%= filters.agentId == agent.id ? 'selected' : '' %>>
                        <%= agent.name %> (<%= agent.agent_code %>)
                    </option>
                <% }); %>
            </select>
        </form>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card highlight">
                <h4><%= analytics.stats?.total_redirects || 0 %></h4>
                <p>Total Redirects</p>
            </div>
            <div class="stat-card">
                <h4><%= analytics.stats?.unique_users || 0 %></h4>
                <p>Unique Users</p>
            </div>
            <div class="stat-card">
                <h4><%= analytics.stats?.agents_used || 0 %></h4>
                <p>Agents Used</p>
            </div>
            <div class="stat-card">
                <h4><%= analytics.stats?.messages_used || 0 %></h4>
                <p>Message Templates</p>
            </div>
        </div>

        <div class="two-columns">
            <!-- Per-Agent Performance -->
            <div class="section">
                <h2>Redirects by Agent</h2>
                <div class="chart-container">
                    <% if (analytics.perAgent && analytics.perAgent.length > 0) { %>
                        <%
                            const maxRedirects = Math.max(...analytics.perAgent.map(a => parseInt(a.recent_redirects) || 0), 1);
                        %>
                        <% analytics.perAgent.forEach(agent => { %>
                            <%
                                const recentCount = parseInt(agent.recent_redirects) || 0;
                                const width = Math.max((recentCount / maxRedirects) * 100, 5);
                            %>
                            <div class="agent-bar">
                                <div class="agent-bar-label">
                                    <%= agent.name %>
                                    <span class="agent-code"><%= agent.agent_code %></span>
                                </div>
                                <div class="agent-bar-track">
                                    <div class="agent-bar-fill" style="width: <%= width %>%;">
                                        <%= recentCount %>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="empty-state">No agent data available</div>
                    <% } %>
                </div>
            </div>

            <!-- Per-Message Usage -->
            <div class="section">
                <h2>Message Template Usage</h2>
                <div class="chart-container">
                    <% if (analytics.perMessage && analytics.perMessage.length > 0) { %>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Template</th>
                                    <th>Slug</th>
                                    <th>Uses</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% analytics.perMessage.forEach(msg => { %>
                                <tr>
                                    <td><%= msg.name %></td>
                                    <td><code><%= msg.slug %></code></td>
                                    <td><strong><%= msg.usage_count || 0 %></strong></td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="empty-state">No message data available</div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Recent Redirect Logs -->
        <div class="section">
            <h2>Recent Redirect Logs</h2>
            <% if (analytics.recentLogs && analytics.recentLogs.length > 0) { %>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>User Phone</th>
                            <th>Agent</th>
                            <th>Message</th>
                            <th>Trigger</th>
                            <th>Message Preview</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% analytics.recentLogs.forEach(log => { %>
                        <tr>
                            <td>
                                <% if (log.redirected_at) { %>
                                    <%= new Date(log.redirected_at).toLocaleString('en-IN', {
                                        day: 'numeric',
                                        month: 'short',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) %>
                                <% } else { %>
                                    -
                                <% } %>
                            </td>
                            <td><%= log.user_phone %></td>
                            <td>
                                <%= log.agent_name || 'Unknown' %>
                            </td>
                            <td><%= log.message_name || 'Unknown' %></td>
                            <td>
                                <span class="trigger-badge <%= log.trigger_type || 'button_click' %>">
                                    <%= (log.trigger_type || 'button_click').replace('_', ' ') %>
                                </span>
                            </td>
                            <td>
                                <div class="message-preview" title="<%= log.message_sent %>">
                                    <%= log.message_sent || '-' %>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <div class="chart-container">
                    <div class="empty-state">
                        <p>No redirect logs yet.</p>
                        <p style="font-size: 14px; margin-top: 10px;">
                            Redirects will appear here when users are directed to sales agents.
                        </p>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
