<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Level Content Analytics - Admin</title>
    <%- include('partials/head') %>
    <style>
        .level-nav {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }
        .level-nav a {
            padding: 8px 15px;
            background: #f0f0f0;
            border-radius: 5px;
            text-decoration: none;
            color: #333;
        }
        .level-nav a.active {
            background: #007bff;
            color: white;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 12px;
            text-align: center;
        }
        .stat-card.revenue {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        }
        .stat-card.purchases {
            background: linear-gradient(135deg, #fc4a1a 0%, #f7b733 100%);
        }
        .stat-card.content {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }
        .stat-card h3 {
            margin: 0;
            font-size: 32px;
            font-weight: bold;
        }
        .stat-card p {
            margin: 8px 0 0;
            font-size: 14px;
            opacity: 0.9;
        }
        .section {
            background: white;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 25px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }
        .section h2 {
            margin: 0 0 20px;
            font-size: 18px;
            color: #333;
            padding-bottom: 10px;
            border-bottom: 2px solid #f0f0f0;
        }
        .top-content-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .top-content-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
            transition: background 0.2s;
        }
        .top-content-item:hover {
            background: #e9ecef;
        }
        .rank {
            width: 30px;
            height: 30px;
            background: #6c5ce7;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
        }
        .rank.gold { background: linear-gradient(135deg, #f5af19, #f12711); }
        .rank.silver { background: linear-gradient(135deg, #bdc3c7, #2c3e50); }
        .rank.bronze { background: linear-gradient(135deg, #c79081, #dfa579); }
        .content-info {
            flex: 1;
        }
        .content-info h4 {
            margin: 0;
            font-size: 15px;
            color: #333;
        }
        .content-info p {
            margin: 4px 0 0;
            font-size: 12px;
            color: #666;
        }
        .content-stats {
            text-align: right;
        }
        .content-stats .purchases {
            font-size: 18px;
            font-weight: bold;
            color: #333;
        }
        .content-stats .xp {
            font-size: 12px;
            color: #28a745;
        }
        .level-badge {
            background: #6c5ce7;
            color: white;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }
        .type-badge {
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
        }
        .type-badge.pdf { background: #e74c3c; color: white; }
        .type-badge.video { background: #9b59b6; color: white; }
        .type-badge.notes { background: #3498db; color: white; }
        .type-badge.other { background: #95a5a6; color: white; }
        .levels-chart {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        .level-card {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            min-width: 100px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .level-card:hover {
            background: #e9ecef;
            transform: translateY(-2px);
        }
        .level-card .level-num {
            font-size: 20px;
            font-weight: bold;
            color: #6c5ce7;
        }
        .level-card .count {
            font-size: 12px;
            color: #666;
            margin-top: 4px;
        }
        .level-card .purchases {
            font-size: 11px;
            color: #28a745;
            margin-top: 2px;
        }
        .two-column {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }
        @media (max-width: 900px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .two-column {
                grid-template-columns: 1fr;
            }
        }
        .empty-message {
            text-align: center;
            padding: 40px;
            color: #666;
        }
        .type-breakdown {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }
        .type-stat {
            flex: 1;
            min-width: 120px;
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
        }
        .type-stat .icon {
            font-size: 24px;
            margin-bottom: 8px;
        }
        .type-stat h4 {
            margin: 0;
            font-size: 24px;
            color: #333;
        }
        .type-stat p {
            margin: 5px 0 0;
            font-size: 12px;
            color: #666;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <div class="level-nav">
            <a href="/admin/level-content">Level Content</a>
            <a href="/admin/level-content/analytics" class="active">Analytics</a>
        </div>

        <h1>Level Content Analytics</h1>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <!-- Main Stats -->
        <div class="stats-grid">
            <div class="stat-card content">
                <h3><%= stats.total_active || 0 %></h3>
                <p>Active Content</p>
            </div>
            <div class="stat-card">
                <h3><%= stats.levels_with_content || 0 %></h3>
                <p>Levels with Content</p>
            </div>
            <div class="stat-card purchases">
                <h3><%= stats.total_purchases || 0 %></h3>
                <p>Total Purchases</p>
            </div>
            <div class="stat-card revenue">
                <h3><%= stats.total_xp_collected || 0 %></h3>
                <p>XP Collected</p>
            </div>
        </div>

        <div class="two-column">
            <!-- Top Selling Content -->
            <div class="section">
                <h2>Top Selling Content</h2>
                <% if (topSelling && topSelling.length > 0) { %>
                <div class="top-content-list">
                    <% topSelling.forEach((item, index) => { %>
                    <div class="top-content-item">
                        <span class="rank <%= index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : '' %>">
                            <%= index + 1 %>
                        </span>
                        <div class="content-info">
                            <h4><%= item.title %></h4>
                            <p>
                                <span class="level-badge">L<%= item.level %></span>
                                <span class="type-badge <%= item.content_type %>"><%= item.content_type %></span>
                                &nbsp;&middot;&nbsp;
                                <%= item.xp_price === 0 ? 'FREE' : item.xp_price + ' XP' %>
                            </p>
                        </div>
                        <div class="content-stats">
                            <div class="purchases"><%= item.total_purchases %></div>
                            <div class="xp"><%= item.total_xp_earned || 0 %> XP earned</div>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% } else { %>
                <div class="empty-message">No purchases yet</div>
                <% } %>
            </div>

            <!-- Content by Type -->
            <div class="section">
                <h2>Content by Type</h2>
                <div class="type-breakdown">
                    <div class="type-stat">
                        <div class="icon">PDF</div>
                        <h4><%= stats.pdf_count || 0 %></h4>
                        <p>PDF Documents</p>
                    </div>
                    <div class="type-stat">
                        <div class="icon">VID</div>
                        <h4><%= stats.video_count || 0 %></h4>
                        <p>Videos</p>
                    </div>
                    <div class="type-stat">
                        <div class="icon">NOTE</div>
                        <h4><%= stats.notes_count || 0 %></h4>
                        <p>Notes</p>
                    </div>
                    <div class="type-stat">
                        <div class="icon">FILE</div>
                        <h4><%= stats.other_count || 0 %></h4>
                        <p>Other</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Levels with Content -->
        <div class="section">
            <h2>Levels with Content</h2>
            <% if (levelsWithContent && levelsWithContent.length > 0) { %>
            <div class="levels-chart">
                <% levelsWithContent.forEach(l => { %>
                <a href="/admin/level-content/level/<%= l.level %>" class="level-card" style="text-decoration: none;">
                    <div class="level-num">L<%= l.level %></div>
                    <div class="count"><%= l.active_count %> items</div>
                    <% if (l.total_purchases > 0) { %>
                    <div class="purchases"><%= l.total_purchases %> sales</div>
                    <% } %>
                </a>
                <% }); %>
            </div>
            <% } else { %>
            <div class="empty-message">
                No levels have content yet. <a href="/admin/level-content/create">Add your first content</a>
            </div>
            <% } %>
        </div>
    </div>
</body>
</html>
