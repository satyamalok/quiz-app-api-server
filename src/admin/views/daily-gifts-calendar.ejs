<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Gifts Calendar - Admin</title>
    <%- include('partials/head') %>
    <style>
        .page-nav {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }
        .page-nav a {
            padding: 8px 15px;
            background: #f0f0f0;
            border-radius: 5px;
            text-decoration: none;
            color: #333;
        }
        .page-nav a.active {
            background: #007bff;
            color: white;
        }
        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .month-nav {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .month-nav a {
            padding: 8px 15px;
            background: #f0f0f0;
            border-radius: 5px;
            text-decoration: none;
            color: #333;
        }
        .month-nav a:hover {
            background: #e0e0e0;
        }
        .current-month {
            font-size: 24px;
            font-weight: bold;
            color: #333;
        }
        .calendar {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 1px;
            background: #ddd;
            border-radius: 8px;
            overflow: hidden;
        }
        .calendar-day-header {
            background: #6c5ce7;
            color: white;
            padding: 10px;
            text-align: center;
            font-weight: bold;
            font-size: 12px;
        }
        .calendar-day {
            background: white;
            min-height: 120px;
            padding: 8px;
            position: relative;
        }
        .calendar-day.other-month {
            background: #f8f9fa;
            opacity: 0.6;
        }
        .calendar-day.today {
            background: #fff3cd;
        }
        .day-number {
            font-size: 14px;
            font-weight: bold;
            color: #333;
            margin-bottom: 5px;
        }
        .calendar-day.today .day-number {
            background: #007bff;
            color: white;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .gift-chip {
            display: block;
            padding: 4px 6px;
            margin-bottom: 4px;
            border-radius: 4px;
            font-size: 11px;
            text-decoration: none;
            color: white;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .gift-chip.pdf { background: #e74c3c; }
        .gift-chip.video { background: #9b59b6; }
        .gift-chip.notes { background: #3498db; }
        .gift-chip.surprise { background: #f39c12; }
        .gift-chip.other { background: #95a5a6; }
        .gift-chip.inactive {
            opacity: 0.5;
            text-decoration: line-through;
        }
        .add-gift-btn {
            position: absolute;
            bottom: 5px;
            right: 5px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #28a745;
            color: white;
            border: none;
            cursor: pointer;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.2s;
        }
        .calendar-day:hover .add-gift-btn {
            opacity: 1;
        }
        .stats-row {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .stat-mini {
            background: #f8f9fa;
            padding: 10px 15px;
            border-radius: 6px;
            font-size: 13px;
        }
        .stat-mini strong {
            color: #333;
        }
        .legend {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
        }
        .legend-color {
            width: 16px;
            height: 16px;
            border-radius: 3px;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <div class="page-nav">
            <a href="/admin/daily-gifts">List View</a>
            <a href="/admin/daily-gifts/calendar" class="active">Calendar View</a>
        </div>

        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <%
            const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                              'July', 'August', 'September', 'October', 'November', 'December'];
            const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

            const prevMonth = month === 1 ? 12 : month - 1;
            const prevYear = month === 1 ? year - 1 : year;
            const nextMonth = month === 12 ? 1 : month + 1;
            const nextYear = month === 12 ? year + 1 : year;

            // Get first day of month and number of days
            const firstDay = new Date(year, month - 1, 1);
            const lastDay = new Date(year, month, 0);
            const startDayOfWeek = firstDay.getDay();
            const daysInMonth = lastDay.getDate();

            // Get days from previous month
            const prevMonthLastDay = new Date(year, month - 1, 0).getDate();

            // Today for comparison
            const today = new Date();
            const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
        %>

        <div class="calendar-header">
            <div class="month-nav">
                <a href="?year=<%= prevYear %>&month=<%= prevMonth %>">&larr; Previous</a>
                <span class="current-month"><%= monthNames[month - 1] %> <%= year %></span>
                <a href="?year=<%= nextYear %>&month=<%= nextMonth %>">Next &rarr;</a>
            </div>
            <a href="/admin/daily-gifts/create" class="btn btn-primary">+ Add Gift</a>
        </div>

        <div class="stats-row">
            <div class="stat-mini">
                <strong><%= stats.today_gifts || 0 %></strong> Today's Gifts
            </div>
            <div class="stat-mini">
                <strong><%= stats.upcoming_gifts || 0 %></strong> Upcoming
            </div>
            <div class="stat-mini">
                <strong><%= stats.total_purchases || 0 %></strong> Total Purchases
            </div>
        </div>

        <div class="legend">
            <div class="legend-item">
                <div class="legend-color" style="background: #e74c3c;"></div>
                <span>PDF</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #9b59b6;"></div>
                <span>Video</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #3498db;"></div>
                <span>Notes</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #f39c12;"></div>
                <span>Surprise</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #95a5a6;"></div>
                <span>Other</span>
            </div>
        </div>

        <div class="calendar">
            <!-- Day headers -->
            <% dayNames.forEach(day => { %>
                <div class="calendar-day-header"><%= day %></div>
            <% }); %>

            <!-- Calendar cells -->
            <%
                let dayCounter = 1;
                let nextMonthDay = 1;
                const totalCells = Math.ceil((startDayOfWeek + daysInMonth) / 7) * 7;

                for (let i = 0; i < totalCells; i++) {
                    let dayNum, dateStr, isOtherMonth = false, isToday = false;

                    if (i < startDayOfWeek) {
                        // Previous month days
                        dayNum = prevMonthLastDay - startDayOfWeek + i + 1;
                        dateStr = `${prevYear}-${String(prevMonth).padStart(2, '0')}-${String(dayNum).padStart(2, '0')}`;
                        isOtherMonth = true;
                    } else if (dayCounter <= daysInMonth) {
                        // Current month days
                        dayNum = dayCounter;
                        dateStr = `${year}-${String(month).padStart(2, '0')}-${String(dayNum).padStart(2, '0')}`;
                        isToday = dateStr === todayStr;
                        dayCounter++;
                    } else {
                        // Next month days
                        dayNum = nextMonthDay;
                        dateStr = `${nextYear}-${String(nextMonth).padStart(2, '0')}-${String(dayNum).padStart(2, '0')}`;
                        isOtherMonth = true;
                        nextMonthDay++;
                    }

                    const dayGifts = giftsByDate[dateStr] || [];
            %>
                <div class="calendar-day <%= isOtherMonth ? 'other-month' : '' %> <%= isToday ? 'today' : '' %>">
                    <div class="day-number"><%= dayNum %></div>

                    <% dayGifts.forEach(gift => { %>
                        <a href="/admin/daily-gifts/<%= gift.id %>/edit"
                           class="gift-chip <%= gift.content_type %> <%= !gift.is_active ? 'inactive' : '' %>"
                           title="<%= gift.title %> - <%= gift.xp_price %> XP (<%= gift.total_purchases || 0 %> purchases)">
                            <%= gift.available_time %> <%= gift.title %>
                        </a>
                    <% }); %>

                    <% if (!isOtherMonth) { %>
                    <a href="/admin/daily-gifts/create?date=<%= dateStr %>" class="add-gift-btn" title="Add gift">+</a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
