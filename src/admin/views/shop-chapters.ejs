<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop Chapters - Admin</title>
    <%- include('partials/head') %>
    <style>
        .shop-nav {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }
        .shop-nav a {
            padding: 8px 15px;
            background: #f0f0f0;
            border-radius: 5px;
            text-decoration: none;
            color: #333;
        }
        .shop-nav a.active {
            background: #007bff;
            color: white;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }
        .stat-card {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }
        .stat-card h3 {
            margin: 0;
            font-size: 24px;
            color: #333;
        }
        .stat-card p {
            margin: 5px 0 0;
            color: #666;
            font-size: 12px;
        }
        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .chapter-icon {
            width: 50px;
            height: 50px;
            border-radius: 8px;
            object-fit: cover;
            background: #eee;
        }
        .chapter-name {
            font-weight: bold;
        }
        .status-badge {
            padding: 3px 8px;
            border-radius: 3px;
            font-size: 11px;
            font-weight: bold;
        }
        .status-active {
            background: #d4edda;
            color: #155724;
        }
        .status-inactive {
            background: #f8d7da;
            color: #721c24;
        }
        .actions-cell {
            white-space: nowrap;
        }
        .actions-cell button, .actions-cell a {
            padding: 5px 10px;
            font-size: 12px;
            margin: 2px;
        }
        .alert {
            padding: 10px 15px;
            border-radius: 5px;
            margin-bottom: 15px;
        }
        .alert-success {
            background: #d4edda;
            color: #155724;
        }
        .alert-error {
            background: #f8d7da;
            color: #721c24;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <div class="shop-nav">
            <a href="/admin/shop/chapters" class="active">Chapters</a>
            <a href="/admin/shop/items">Items</a>
            <a href="/admin/shop/purchases">Purchases</a>
            <a href="/admin/shop/analytics">Analytics</a>
            <a href="/admin/shop/leaderboard">Balance Leaderboard</a>
        </div>

        <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
        <% } %>

        <div class="stats-grid">
            <div class="stat-card">
                <h3><%= stats.total_chapters || 0 %></h3>
                <p>Total Chapters</p>
            </div>
            <div class="stat-card">
                <h3><%= stats.total_items || 0 %></h3>
                <p>Total Items</p>
            </div>
            <div class="stat-card">
                <h3><%= stats.total_purchases || 0 %></h3>
                <p>Total Purchases</p>
            </div>
            <div class="stat-card">
                <h3><%= (stats.total_xp_collected || 0).toLocaleString() %></h3>
                <p>XP Collected</p>
            </div>
        </div>

        <div class="header-row">
            <h2>Shop Chapters</h2>
            <a href="/admin/shop/chapters/create" class="btn btn-primary">+ New Chapter</a>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Icon</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Items</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="chaptersBody">
                <% chapters.forEach((chapter, index) => { %>
                <tr data-id="<%= chapter.id %>">
                    <td><%= chapter.display_order %></td>
                    <td>
                        <% if (chapter.icon_url) { %>
                        <img src="<%= chapter.icon_url %>" class="chapter-icon" alt="">
                        <% } else { %>
                        <div class="chapter-icon" style="display:flex;align-items:center;justify-content:center;font-size:20px;">📁</div>
                        <% } %>
                    </td>
                    <td class="chapter-name"><%= chapter.name %></td>
                    <td><%= chapter.description ? chapter.description.substring(0, 50) + '...' : '-' %></td>
                    <td><%= chapter.total_items %></td>
                    <td>
                        <span class="status-badge <%= chapter.is_active ? 'status-active' : 'status-inactive' %>">
                            <%= chapter.is_active ? 'Active' : 'Inactive' %>
                        </span>
                    </td>
                    <td class="actions-cell">
                        <a href="/admin/shop/chapters/<%= chapter.id %>/edit" class="btn btn-secondary">Edit</a>
                        <form action="/admin/shop/chapters/<%= chapter.id %>/delete" method="POST" style="display:inline"
                              onsubmit="return confirm('Delete this chapter and all its items?')">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
                <% }); %>
                <% if (chapters.length === 0) { %>
                <tr>
                    <td colspan="7" style="text-align:center;padding:30px;">
                        No chapters yet. <a href="/admin/shop/chapters/create">Create your first chapter</a>
                    </td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>
