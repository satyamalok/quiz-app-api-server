<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Level <%= level %> Content - Admin</title>
    <%- include('partials/head') %>
    <style>
        .level-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .level-badge-large {
            background: #6c5ce7;
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 24px;
            font-weight: bold;
        }
        .content-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }
        .content-card {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .content-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }
        .content-thumbnail {
            width: 100%;
            height: 150px;
            object-fit: cover;
            background: #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #999;
            font-size: 36px;
        }
        .content-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .content-body {
            padding: 15px;
        }
        .content-title {
            font-size: 16px;
            font-weight: 600;
            margin: 0 0 8px;
            color: #333;
        }
        .content-description {
            font-size: 13px;
            color: #666;
            margin: 0 0 10px;
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .content-meta {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 10px;
        }
        .type-badge {
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .type-badge.pdf { background: #e74c3c; color: white; }
        .type-badge.video { background: #9b59b6; color: white; }
        .type-badge.notes { background: #3498db; color: white; }
        .type-badge.other { background: #95a5a6; color: white; }
        .status-badge {
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
        }
        .status-badge.active { background: #d4edda; color: #155724; }
        .status-badge.inactive { background: #f8d7da; color: #721c24; }
        .featured-badge {
            background: #ffd93d;
            color: #333;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
        }
        .content-pricing {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
        }
        .price {
            font-size: 18px;
            font-weight: bold;
            color: #2ecc71;
        }
        .price.free { color: #27ae60; }
        .original-price {
            text-decoration: line-through;
            color: #999;
            font-size: 14px;
        }
        .sale-badge {
            background: #ff6b6b;
            color: white;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 10px;
        }
        .content-stats {
            display: flex;
            gap: 15px;
            font-size: 12px;
            color: #666;
            padding-top: 10px;
            border-top: 1px solid #eee;
        }
        .content-stats span {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .content-actions {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }
        .content-actions .btn {
            flex: 1;
            text-align: center;
            padding: 8px;
            font-size: 12px;
        }
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: #f8f9fa;
            border-radius: 10px;
        }
        .empty-state h3 {
            margin: 0 0 10px;
            color: #666;
        }
        .empty-state p {
            color: #999;
            margin: 0 0 20px;
        }
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: #666;
            text-decoration: none;
            margin-bottom: 15px;
        }
        .back-link:hover {
            color: #333;
        }
        .stats-summary {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .stat-item {
            background: #f8f9fa;
            padding: 15px 20px;
            border-radius: 8px;
            text-align: center;
            min-width: 120px;
        }
        .stat-item h4 {
            margin: 0;
            font-size: 24px;
            color: #333;
        }
        .stat-item p {
            margin: 5px 0 0;
            font-size: 12px;
            color: #666;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <a href="/admin/level-content" class="back-link">&larr; Back to All Content</a>

        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="level-header">
            <div>
                <span class="level-badge-large">Level <%= level %></span>
                <h1 style="margin: 10px 0 0; font-size: 18px; color: #666;">Content for this level</h1>
            </div>
            <a href="/admin/level-content/create?level=<%= level %>" class="btn btn-primary">+ Add Content for Level <%= level %></a>
        </div>

        <!-- Stats Summary -->
        <div class="stats-summary">
            <div class="stat-item">
                <h4><%= content.length %></h4>
                <p>Total Items</p>
            </div>
            <div class="stat-item">
                <h4><%= content.filter(c => c.is_active).length %></h4>
                <p>Active</p>
            </div>
            <div class="stat-item">
                <h4><%= content.reduce((sum, c) => sum + (c.total_purchases || 0), 0) %></h4>
                <p>Total Purchases</p>
            </div>
            <div class="stat-item">
                <h4><%= content.reduce((sum, c) => sum + (c.total_xp_earned || 0), 0) %> XP</h4>
                <p>XP Earned</p>
            </div>
        </div>

        <% if (content && content.length > 0) { %>
        <div class="content-grid">
            <% content.forEach(item => { %>
            <div class="content-card">
                <div class="content-thumbnail">
                    <% if (item.thumbnail_url) { %>
                        <img src="<%= item.thumbnail_url %>" alt="<%= item.title %>">
                    <% } else { %>
                        <% if (item.content_type === 'pdf') { %>PDF
                        <% } else if (item.content_type === 'video') { %>VID
                        <% } else if (item.content_type === 'notes') { %>NOTE
                        <% } else { %>FILE<% } %>
                    <% } %>
                </div>
                <div class="content-body">
                    <h3 class="content-title"><%= item.title %></h3>
                    <% if (item.description) { %>
                    <p class="content-description"><%= item.description %></p>
                    <% } %>

                    <div class="content-meta">
                        <span class="type-badge <%= item.content_type %>"><%= item.content_type %></span>
                        <span class="status-badge <%= item.is_active ? 'active' : 'inactive' %>">
                            <%= item.is_active ? 'Active' : 'Inactive' %>
                        </span>
                        <% if (item.is_featured) { %>
                        <span class="featured-badge">Featured</span>
                        <% } %>
                    </div>

                    <div class="content-pricing">
                        <% if (item.xp_price === 0) { %>
                            <span class="price free">FREE</span>
                        <% } else { %>
                            <span class="price"><%= item.xp_price %> XP</span>
                            <% if (item.is_on_sale && item.xp_original_price) { %>
                                <span class="original-price"><%= item.xp_original_price %> XP</span>
                                <span class="sale-badge">SALE</span>
                            <% } %>
                        <% } %>
                    </div>

                    <div class="content-stats">
                        <span><%= item.total_purchases || 0 %> purchases</span>
                        <% if (item.file_size_bytes) { %>
                        <span><%= Math.round(item.file_size_bytes / 1024 / 1024 * 10) / 10 %> MB</span>
                        <% } %>
                        <% if (item.page_count) { %>
                        <span><%= item.page_count %> pages</span>
                        <% } %>
                        <% if (item.duration_seconds) { %>
                        <span><%= Math.floor(item.duration_seconds / 60) %>:<%= String(item.duration_seconds % 60).padStart(2, '0') %></span>
                        <% } %>
                    </div>

                    <div class="content-actions">
                        <a href="<%= item.file_url %>" target="_blank" class="btn btn-secondary btn-sm">View</a>
                        <a href="/admin/level-content/<%= item.id %>/edit" class="btn btn-primary btn-sm">Edit</a>
                        <form action="/admin/level-content/<%= item.id %>/delete" method="POST" style="flex: 1;">
                            <button type="submit" class="btn btn-danger btn-sm" style="width: 100%;"
                                    onclick="return confirm('Delete this content?')">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>
        <% } else { %>
        <div class="empty-state">
            <h3>No Content for Level <%= level %></h3>
            <p>Add PDFs, videos, or notes for students who complete this level.</p>
            <a href="/admin/level-content/create?level=<%= level %>" class="btn btn-primary">Add First Content</a>
        </div>
        <% } %>
    </div>
</body>
</html>
