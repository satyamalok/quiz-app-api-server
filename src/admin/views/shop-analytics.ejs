<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop Analytics - Admin</title>
    <%- include('partials/head') %>
    <style>
        .shop-nav {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }
        .shop-nav a {
            padding: 8px 15px;
            background: #f0f0f0;
            border-radius: 5px;
            text-decoration: none;
            color: #333;
        }
        .shop-nav a.active {
            background: #007bff;
            color: white;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
        }
        .stat-card.highlight {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
        }
        .stat-card h3 {
            margin: 0;
            font-size: 28px;
        }
        .stat-card p {
            margin: 8px 0 0;
            font-size: 13px;
            opacity: 0.8;
        }
        .section-title {
            font-size: 18px;
            font-weight: bold;
            margin: 30px 0 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid #007bff;
        }
        .analytics-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            margin-bottom: 30px;
        }
        .analytics-card {
            background: white;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 20px;
        }
        .analytics-card h4 {
            margin: 0 0 15px;
            color: #333;
        }
        .top-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }
        .top-item:last-child {
            border-bottom: none;
        }
        .top-item-rank {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 12px;
        }
        .top-item-rank.gold { background: #ffd700; color: #333; }
        .top-item-rank.silver { background: #c0c0c0; color: #333; }
        .top-item-rank.bronze { background: #cd7f32; color: white; }
        .top-item-info {
            flex: 1;
            margin: 0 15px;
        }
        .top-item-title {
            font-weight: 500;
            margin-bottom: 3px;
        }
        .top-item-meta {
            font-size: 12px;
            color: #666;
        }
        .top-item-value {
            font-weight: bold;
            color: #007bff;
        }
        .recent-table {
            width: 100%;
        }
        .recent-table th, .recent-table td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }
        .period-selector {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }
        .period-btn {
            padding: 8px 15px;
            border: 1px solid #ddd;
            background: white;
            border-radius: 5px;
            cursor: pointer;
        }
        .period-btn.active {
            background: #007bff;
            color: white;
            border-color: #007bff;
        }
        .chapter-bar {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }
        .chapter-bar-name {
            width: 120px;
            font-size: 13px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .chapter-bar-fill {
            flex: 1;
            height: 20px;
            background: #e9ecef;
            border-radius: 4px;
            margin: 0 10px;
            overflow: hidden;
        }
        .chapter-bar-inner {
            height: 100%;
            background: linear-gradient(90deg, #28a745, #20c997);
            border-radius: 4px;
        }
        .chapter-bar-value {
            width: 60px;
            text-align: right;
            font-size: 13px;
            font-weight: bold;
        }
        .empty-state {
            text-align: center;
            padding: 30px;
            color: #666;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container">
        <div class="shop-nav">
            <a href="/admin/shop/chapters">Chapters</a>
            <a href="/admin/shop/items">Items</a>
            <a href="/admin/shop/purchases">Purchases</a>
            <a href="/admin/shop/analytics" class="active">Analytics</a>
            <a href="/admin/shop/leaderboard">Balance Leaderboard</a>
        </div>

        <h2>Shop Analytics</h2>

        <!-- Overview Stats -->
        <%
            const avgXpPerPurchase = analytics.total_purchases > 0
                ? Math.round((analytics.total_xp_collected || 0) / analytics.total_purchases)
                : 0;
        %>
        <div class="stats-grid">
            <div class="stat-card highlight">
                <h3><%= (analytics.total_xp_collected || 0).toLocaleString() %></h3>
                <p>Total XP Collected</p>
            </div>
            <div class="stat-card">
                <h3><%= analytics.total_purchases || 0 %></h3>
                <p>Total Purchases</p>
            </div>
            <div class="stat-card">
                <h3><%= analytics.unique_buyers || 0 %></h3>
                <p>Unique Buyers</p>
            </div>
            <div class="stat-card">
                <h3><%= avgXpPerPurchase %></h3>
                <p>Avg XP per Purchase</p>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <h3><%= analytics.total_items || 0 %></h3>
                <p>Total Items</p>
            </div>
            <div class="stat-card">
                <h3><%= analytics.active_items || 0 %></h3>
                <p>Active Items</p>
            </div>
            <div class="stat-card">
                <h3><%= analytics.free_items || 0 %></h3>
                <p>Free Items</p>
            </div>
            <div class="stat-card">
                <h3><%= analytics.items_on_sale || 0 %></h3>
                <p>Items on Sale</p>
            </div>
        </div>

        <div class="analytics-grid">
            <!-- Top Selling Items -->
            <div class="analytics-card">
                <h4>Top Selling Items</h4>
                <% if (topItems && topItems.length > 0) { %>
                <% topItems.forEach((item, index) => { %>
                <div class="top-item">
                    <div class="top-item-rank <%= index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : '' %>">
                        <%= index + 1 %>
                    </div>
                    <div class="top-item-info">
                        <div class="top-item-title"><%= item.title %></div>
                        <div class="top-item-meta"><%= item.chapter_name %> &bull; <%= item.xp_price %> XP</div>
                    </div>
                    <div class="top-item-value"><%= item.total_purchases %> sales</div>
                </div>
                <% }); %>
                <% } else { %>
                <div class="empty-state">No sales yet</div>
                <% } %>
            </div>

            <!-- Top Buyers -->
            <div class="analytics-card">
                <h4>Top Buyers (by purchases)</h4>
                <% if (topBuyers && topBuyers.length > 0) { %>
                <% topBuyers.forEach((buyer, index) => { %>
                <div class="top-item">
                    <div class="top-item-rank <%= index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : '' %>">
                        <%= index + 1 %>
                    </div>
                    <div class="top-item-info">
                        <div class="top-item-title"><%= buyer.name || 'Anonymous' %></div>
                        <div class="top-item-meta">
                            <a href="/admin/shop/user/<%= buyer.phone %>/purchases"><%= buyer.phone %></a>
                        </div>
                    </div>
                    <div class="top-item-value"><%= buyer.total_purchases %> items</div>
                </div>
                <% }); %>
                <% } else { %>
                <div class="empty-state">No buyers yet</div>
                <% } %>
            </div>
        </div>

        <!-- Sales by Chapter -->
        <div class="section-title">Sales by Chapter</div>
        <div class="analytics-card">
            <% if (chapterStats && chapterStats.length > 0) { %>
            <%
                const maxSales = Math.max(...chapterStats.map(c => parseInt(c.total_purchases) || 0), 1);
            %>
            <% chapterStats.forEach(chapter => { %>
            <div class="chapter-bar">
                <div class="chapter-bar-name" title="<%= chapter.name %>"><%= chapter.name %></div>
                <div class="chapter-bar-fill">
                    <div class="chapter-bar-inner" style="width: <%= ((parseInt(chapter.total_purchases) || 0) / maxSales * 100) %>%"></div>
                </div>
                <div class="chapter-bar-value"><%= chapter.total_purchases || 0 %></div>
            </div>
            <% }); %>
            <% } else { %>
            <div class="empty-state">No chapter data</div>
            <% } %>
        </div>

        <!-- Recent Activity -->
        <div class="section-title">Recent Purchases</div>
        <div class="analytics-card">
            <% if (recentPurchases && recentPurchases.length > 0) { %>
            <table class="recent-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>User</th>
                        <th>Item</th>
                        <th>XP Paid</th>
                    </tr>
                </thead>
                <tbody>
                    <% recentPurchases.forEach(p => { %>
                    <tr>
                        <td><%= new Date(p.purchased_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) %></td>
                        <td>
                            <a href="/admin/shop/user/<%= p.phone %>/purchases"><%= p.user_name || p.phone %></a>
                        </td>
                        <td><%= p.item_title %></td>
                        <td><strong><%= p.xp_paid %> XP</strong></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <div class="empty-state">No recent purchases</div>
            <% } %>
        </div>
    </div>
</body>
</html>
